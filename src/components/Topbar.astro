---
const { user } = Astro.locals;
---

<header class="flex min-h-12 items-center justify-end gap-4 border-b border-white/15 pb-4 text-sm text-white/80">
  {user ? (
    <>
      <span class="text-blue-100/70">{user.email}</span>
      <div class="flex items-center gap-3">
        <a href="/dashboard" class="text-orange-300 transition-colors hover:text-orange-200 hover:underline">
          Dashboard
        </a>
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class="text-orange-300 transition-colors hover:text-orange-200 hover:underline">
            Sign out
          </button>
        </form>
      </div>
    </>
  ) : (
    <nav aria-label="Account" class="flex items-center gap-3">
      <a href="/auth/signin" class="text-orange-300 transition-colors hover:text-orange-200 hover:underline">
        Sign in
      </a>
      <a
        href="/auth/signup"
        class="rounded-md bg-orange-500 px-3 py-2 font-semibold text-white transition-colors hover:bg-orange-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-200"
      >
        Sign up
      </a>
    </nav>
  )}
</header>
