---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign in | ChainTrack">
  <main class="flex min-h-screen items-center justify-center bg-slate-950 p-4 text-white">
    <div class="w-full max-w-sm rounded-lg border border-white/10 bg-slate-900/80 p-6 shadow-2xl shadow-black/20 sm:p-8">
      <p class="mb-2 text-center text-sm font-semibold text-orange-300">ChainTrack</p>
      <h1 class="mb-6 text-center text-2xl font-semibold">Sign in</h1>
      <SignInForm serverError={error} client:load />
      <p class="mt-4 text-center text-sm text-blue-100/60">
        Don't have an account?{" "}
        <a
          href="/auth/signup"
          class="text-orange-300 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-300"
        >
          Sign up
        </a>
      </p>
    </div>
  </main>
</Layout>
