---
import Layout from "@/layouts/Layout.astro";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      emoji: "✅",
      heading: "Registration successful",
      description: "Your account has been created. You can now sign in.",
      linkText: "Go to sign in",
    }
  : {
      emoji: "📧",
      heading: "Check your email",
      description: "We've sent a confirmation link to your email address. Click it to activate your account.",
      linkText: "Back to sign in",
    };
---

<Layout title={`${content.heading} | ChainTrack`}>
  <main class="flex min-h-screen items-center justify-center bg-slate-950 p-4 text-white">
    <div class="w-full max-w-sm rounded-lg border border-white/10 bg-slate-900/80 p-6 text-center shadow-2xl shadow-black/20 sm:p-8">
      <p class="mb-4 text-sm font-semibold text-orange-300">ChainTrack</p>
      <div class="mb-4 text-5xl">{content.emoji}</div>
      <h1 class="mb-3 text-2xl font-semibold">{content.heading}</h1>
      <p class="mb-6 text-blue-100/80">{content.description}</p>
      <a
        href="/auth/signin"
        class="text-sm text-orange-300 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-300"
      >
        {content.linkText}
      </a>
    </div>
  </main>
</Layout>
