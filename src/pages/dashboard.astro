---
import ActivityDashboard from "@/components/ActivityDashboard";
import Layout from "@/layouts/Layout.astro";
import { toActivityViews } from "@/lib/strava/activity-view.ts";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;
let connectionStatus: "connected" | "not-connected" | "unavailable" = "unavailable";
let initialActivities = [] as ReturnType<typeof toActivityViews>;
let initialLoadError = false;

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (supabase && user) {
  const { data: connection, error: connectionError } = await supabase
    .from("strava_connections")
    .select("user_id")
    .eq("user_id", user.id)
    .maybeSingle();

  if (connectionError) {
    connectionStatus = "unavailable";
  } else if (!connection) {
    connectionStatus = "not-connected";
  } else {
    connectionStatus = "connected";
    const [{ data: activities, error: activityError }, { data: bikes, error: bikeError }] = await Promise.all([
      supabase
        .from("activities")
        .select("id, name, distance_meters, started_at, bike_id")
        .eq("user_id", user.id)
        .order("started_at", { ascending: false }),
      supabase.from("bikes").select("id, name").eq("user_id", user.id),
    ]);

    if (activityError || bikeError) {
      initialLoadError = true;
    } else {
      initialActivities = toActivityViews(activities, bikes);
    }
  }
}
---

<Layout title="Dashboard">
  <div class="bg-cosmic min-h-screen">
    <ActivityDashboard
      client:load
      connectionStatus={connectionStatus}
      initialActivities={initialActivities}
      initialLoadError={initialLoadError}
    />
  </div>
</Layout>
