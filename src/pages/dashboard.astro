---
import ActivityDashboard from "@/components/ActivityDashboard";
import Layout from "@/layouts/Layout.astro";
import type { SupabaseClient } from "@supabase/supabase-js";
import { toActivityViews } from "@/lib/strava/activity-view.ts";
import { createClient } from "@/lib/supabase";
import type { StravaSyncDatabase } from "@/lib/strava/sync-database.ts";

const { user } = Astro.locals;
let connectionStatus: "connected" | "not-connected" | "unavailable" = "unavailable";
let initialActivities = [] as ReturnType<typeof toActivityViews>;
let initialLoadError = false;
let initialHasMoreActivities = false;
let initialImportCompleted = false;
let initialActiveSyncRun = null as { id: string; mode: "new" | "repair"; status: "running" | "partial" } | null;

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (supabase && user) {
  const db = supabase as unknown as SupabaseClient<StravaSyncDatabase>;
  const { data: connection, error: connectionError } = await db
    .from("strava_connections")
    .select("user_id, initial_import_completed_at")
    .eq("user_id", user.id)
    .maybeSingle();

  if (connectionError) {
    connectionStatus = "unavailable";
  } else if (!connection) {
    connectionStatus = "not-connected";
  } else {
    connectionStatus = "connected";
    initialImportCompleted = Boolean(connection.initial_import_completed_at);
    const [{ data: activeRun, error: activeRunError }, { data: activities, error: activityError }] = await Promise.all([
      db
        .from("strava_sync_runs")
        .select("id, mode, status")
        .eq("user_id", user.id)
        .in("status", ["running", "partial"])
        .maybeSingle(),
      db
        .from("activities")
        .select("id, name, distance_meters, started_at, bike_id")
        .eq("user_id", user.id)
        .not("bike_id", "is", null)
        .order("started_at", { ascending: false })
        .order("id", { ascending: false })
        .range(0, 100),
    ]);

    if (!activeRunError && activeRun) {
      initialActiveSyncRun = {
        id: activeRun.id,
        mode: activeRun.mode,
        status: activeRun.status === "partial" ? "partial" : "running",
      };
    }

    if (activityError) {
      initialLoadError = true;
    } else {
      const bikeLinkedActivities = activities.filter(
        (activity): activity is typeof activity & { bike_id: string } => activity.bike_id !== null,
      );
      const bikeIds = [...new Set(bikeLinkedActivities.map((activity) => activity.bike_id))];
      const { data: bikes, error: bikeError } =
        bikeIds.length > 0
          ? await db.from("bikes").select("id, name").eq("user_id", user.id).in("id", bikeIds)
          : { data: [], error: null };
      if (bikeError) {
        initialLoadError = true;
      } else {
        initialHasMoreActivities = activities.length > 100;
        initialActivities = toActivityViews(bikeLinkedActivities.slice(0, 100), bikes);
      }
    }
  }
}
---

<Layout title="Dashboard">
  <div class="bg-cosmic min-h-screen">
    <ActivityDashboard
      client:load
      connectionStatus={connectionStatus}
      initialActivities={initialActivities}
      initialLoadError={initialLoadError}
      initialHasMoreActivities={initialHasMoreActivities}
      initialImportCompleted={initialImportCompleted}
      initialActiveSyncRun={initialActiveSyncRun}
    />
  </div>
</Layout>
