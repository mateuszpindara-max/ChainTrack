---
import ActivityDashboard from "@/components/ActivityDashboard";
import Layout from "@/layouts/Layout.astro";
import type { SupabaseClient } from "@supabase/supabase-js";
import type { BikeRow } from "@/lib/strava/activity-view.ts";
import { toChainView, type ChainView } from "@/lib/chains/chain.ts";
import type { ChainsDatabase } from "@/lib/chains/database.ts";
import { createClient } from "@/lib/supabase";
import type { StravaSyncDatabase } from "@/lib/strava/sync-database.ts";

const { user } = Astro.locals;
let connectionStatus: "connected" | "not-connected" | "unavailable" = "unavailable";
let initialBikes: BikeRow[] = [];
let initialBikesHasMore = false;
let initialBikesError = false;
let initialChains: ChainView[] = [];
let initialChainsHasMore = false;
let initialChainsError = false;
let initialImportCompleted = false;
let initialActiveSyncRun = null as { id: string; mode: "new" | "repair"; status: "running" | "partial" } | null;

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (supabase && user) {
  const db = supabase as unknown as SupabaseClient<StravaSyncDatabase>;
  const chainsDb = supabase as unknown as SupabaseClient<ChainsDatabase>;
  const [{ data: bikeRows, error: bikeError }, { data: chainRows, error: chainError }] = await Promise.all([
    db
      .from("bikes")
      .select("id, name")
      .eq("user_id", user.id)
      .order("name", { ascending: true })
      .order("id", { ascending: true })
      .range(0, 100),
    chainsDb
      .from("chains")
      .select("id, name, starting_distance_meters, created_at")
      .eq("user_id", user.id)
      .order("created_at", { ascending: false })
      .order("id", { ascending: false })
      .range(0, 100),
  ]);
  if (bikeError) {
    initialBikesError = true;
  } else {
    initialBikesHasMore = bikeRows.length > 100;
    initialBikes = bikeRows.slice(0, 100);
  }
  if (chainError) {
    initialChainsError = true;
  } else {
    initialChainsHasMore = chainRows.length > 100;
    initialChains = chainRows.slice(0, 100).map(toChainView);
  }

  const { data: connection, error: connectionError } = await db
    .from("strava_connections")
    .select("user_id, initial_import_completed_at")
    .eq("user_id", user.id)
    .maybeSingle();

  if (connectionError) {
    connectionStatus = "unavailable";
  } else if (!connection) {
    connectionStatus = "not-connected";
  } else {
    connectionStatus = "connected";
    initialImportCompleted = Boolean(connection.initial_import_completed_at);
    const { data: activeRun, error: activeRunError } = await db
      .from("strava_sync_runs")
      .select("id, mode, status")
      .eq("user_id", user.id)
      .in("status", ["running", "partial"])
      .maybeSingle();

    if (!activeRunError && activeRun) {
      initialActiveSyncRun = {
        id: activeRun.id,
        mode: activeRun.mode,
        status: activeRun.status === "partial" ? "partial" : "running",
      };
    }
  }
} else if (user) {
  initialBikesError = true;
  initialChainsError = true;
}
---

<Layout title="Dashboard">
  <div class="bg-cosmic min-h-screen">
    <ActivityDashboard
      client:load
      connectionStatus={connectionStatus}
      initialBikes={initialBikes}
      initialBikesHasMore={initialBikesHasMore}
      initialBikesError={initialBikesError}
      initialChains={initialChains}
      initialChainsHasMore={initialChainsHasMore}
      initialChainsError={initialChainsError}
      initialImportCompleted={initialImportCompleted}
      initialActiveSyncRun={initialActiveSyncRun}
    />
  </div>
</Layout>
