---
import ChainManager from "@/components/ChainManager";
import Layout from "@/layouts/Layout.astro";
import type { SupabaseClient } from "@supabase/supabase-js";
import { toChainView, type ChainView } from "@/lib/chains/chain.ts";
import type { ChainsDatabase } from "@/lib/chains/database.ts";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;
let initialChains: ChainView[] = [];
let initialHasMore = false;
let initialLoadError = false;

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (supabase && user) {
  const db = supabase as unknown as SupabaseClient<ChainsDatabase>;
  const { data, error } = await db
    .from("chains")
    .select("id, name, starting_distance_meters, created_at")
    .eq("user_id", user.id)
    .order("created_at", { ascending: false })
    .order("id", { ascending: false })
    .range(0, 100);

  if (error) {
    initialLoadError = true;
  } else {
    initialHasMore = data.length > 100;
    initialChains = data.slice(0, 100).map(toChainView);
  }
} else {
  initialLoadError = true;
}
---

<Layout title="Your chains">
  <div class="bg-cosmic min-h-screen">
    <ChainManager
      client:load
      initialChains={initialChains}
      initialHasMore={initialHasMore}
      initialLoadError={initialLoadError}
    />
  </div>
</Layout>
