{
  "eslint.enable": true,
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact", "astro"],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "chat.tools.terminal.autoApprove": {
    "/^node --experimental-strip-types --test src/lib/strava/import\\.test\\.ts$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "npx eslint": true,
    "npx prettier": true,
    "git add": true,
    "git checkout": true,
    "pbcopy": true,
    "clip.exe": true,
    "xclip": true,
    "true": true,
    "git rev-parse": true,
    "command": true,
    "npx supabase": true,
    "/^node --experimental-strip-types --test --test-name-pattern='repair verifies absent local IDs only after the empty page' src/lib/strava/import\\.test\\.ts$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "npx tsc": true
  }
}
