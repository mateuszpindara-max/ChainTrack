{
  "eslint.enable": true,
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact", "astro"],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "chat.tools.terminal.autoApprove": {
    "/^node --experimental-strip-types --test src/lib/strava/import\\.test\\.ts$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "npx eslint": true,
    "npx prettier": true,
    "git add": true,
    "git checkout": true,
    "pbcopy": true,
    "clip.exe": true,
    "xclip": true,
    "true": true,
    "git rev-parse": true,
    "command": true,
    "npx supabase": true,
    "/^node --experimental-strip-types --test --test-name-pattern='repair verifies absent local IDs only after the empty page' src/lib/strava/import\\.test\\.ts$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "npx tsc": true,
    "git commit": true,
    "/^node --input-type=module -e 'import \\{ ESLint \\} from \"eslint\"; const eslint=new ESLint\\(\\{cwd:process\\.cwd\\(\\)\\}\\); const \\[result\\]=await eslint\\.lintFiles\\(\\[\"src/components/ActivityDashboard\\.tsx\"\\]\\); const config=await eslint\\.calculateConfigForFile\\(\"src/components/ActivityDashboard\\.tsx\"\\); console\\.log\\(JSON\\.stringify\\(\\{cwd:process\\.cwd\\(\\),file:result\\.filePath,errorCount:result\\.errorCount,warningCount:result\\.warningCount,messages:result\\.messages,ruleSeverity:config\\.rules\\[\"@typescript-eslint/no-redundant-type-constituents\"\\]\\},null,2\\)\\);'$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "npm exec": true,
    "printf": true,
    "git remote": true,
    "test": true,
    "awk": true,
    "git ls-remote": true,
    "gh": true
  }
}
